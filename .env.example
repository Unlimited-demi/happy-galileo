# AI Remote Workstation Configuration
# Copy this file to .env on your server

# Wildcard base domain
BASE_DOMAIN=dev-server.datakrib.com

# Docker internal network name
DEVCTL_DOCKER_NETWORK=dev-net

# Caddy Admin API
CADDY_ADMIN_API=http://127.0.0.1:2019

# AI-Ops Monitoring
MONITOR_INTERVAL_SECONDS=15
HTTP_TIMEOUT_SECONDS=5
AUTO_REMEDIATION_ENABLED=true
MAX_AUTO_RESTARTS=3

# Status Dashboard
DASHBOARD_PORT=8888
DASHBOARD_HOST=0.0.0.0
