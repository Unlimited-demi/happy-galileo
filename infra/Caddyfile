{
    # Enable Caddy Admin API on internal network for devctl dynamic routing
    admin 0.0.0.0:2019
    email unlimiteddemi@gmail.com

    # On-Demand TLS automatically provisions valid HTTPS certificates via HTTP-01
    # without needing complex DNS-01 API keys
    on_demand_tls {
        interval 2m
        burst 10
    }
}

# 1. Status & AI-Ops Dashboard Ingress
status.dev-server.datakrib.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy dashboard:8888
}

# 2. Dynamic On-Demand TLS for all services on *.dev-server.datakrib.com
# devctl dynamically injects reverse_proxy handlers via Caddy Admin API
https:// {
    tls {
        on_demand
    }
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
