{
    admin 0.0.0.0:2019
    email unlimiteddemi@gmail.com

    # Security permission module: validates domain before issuing on-demand SSL certificate
    on_demand_tls {
        ask http://dashboard:8888/api/ask
    }
}

# 1. Status & AI-Ops Dashboard Ingress
status.dev-server.datakrib.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy dashboard:8888
}

# 2. Dynamic HTTPS Ingress with On-Demand TLS
# Dynamically routed services injected by devctl will match before this fallback
:443 {
    tls {
        on_demand
    }
    encode zstd gzip

    respond "No active service exposed on this domain. Use 'devctl expose <service> <port>'." 404
}
