# ==============================================================================
# Ephemeral OpenCode Remediation Sandbox Runner
# ==============================================================================
# Security Specifications:
# 1. Non-root user execution (UID 1000: 'sandbox')
# 2. ZERO Docker socket access (no /var/run/docker.sock)
# 3. Read/write strictly scoped to mounted /workspace volume
# 4. PR-only execution pipeline: changes are committed to a fix branch only.
# ==============================================================================

FROM python:3.11-slim

# Install system utilities, Git, Node.js (for OpenCode / JS tooling), and security linters
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    jq \
    tmux \
    ca-certificates \
    gnupg \
    build-essential \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g opencode-ai \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged sandbox user
RUN groupadd -g 1000 sandbox && \
    useradd -u 1000 -g sandbox -m -s /bin/bash sandbox

# Setup workspace
RUN mkdir -p /workspace && chown -R sandbox:sandbox /workspace /home/sandbox

WORKDIR /workspace
USER sandbox

# Environment configuration
ENV HOME=/home/sandbox \
    PATH=/home/sandbox/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    OPENCODE_SANDBOX=1

CMD ["opencode", "--help"]
