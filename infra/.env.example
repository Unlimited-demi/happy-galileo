# ==============================================================================
# ServerGuard Infrastructure Environment Configuration
# Copy to infra/.env and customize for each node.
# ==============================================================================

# ── Node Identity ──
# Unique name for this server (shown in fleet dashboard)
NODE_NAME=Primary Workstation

# ── Domain Scope ──
# All services get auto-exposed as *.BASE_DOMAIN via Caddy on-demand TLS
BASE_DOMAIN=dev-server.datakrib.com

# ── Caddy Port Configuration ──
# For nodes WITH an existing nginx/caddy on 80/443, change these to 8080/8443
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── Fleet Telemetry (sub-nodes only) ──
# Leave empty for STANDALONE mode (this node IS the hub)
# For sub-nodes, set to the hub's telemetry ingest URL:
#   CENTRAL_HUB_URL=https://status.dev-server.datakrib.com/api/telemetry/ingest
CENTRAL_HUB_URL=

# ── Fleet Authentication (sub-nodes only) ──
# Must match the fleet key configured on the hub's auth.json
# Default: default-fleet-key
FLEET_KEY=
