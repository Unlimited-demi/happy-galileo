# ==============================================================================
# Ansible Fleet Inventory Example
# Define all company servers, developers, GPU boxes, and staging environments
# ==============================================================================

[dev_fleet]
# Format: <node_slug> ansible_host=<IP> ansible_user=<SSH_USER> base_domain=<FQDN>

# General Development Nodes
node1 ansible_host=198.51.100.10 ansible_user=root base_domain=dev-server.datakrib.com
node2 ansible_host=198.51.100.11 ansible_user=root base_domain=node2.datakrib.com

# Dedicated GPU / AI Inference Workstation
gpu-box ansible_host=198.51.100.20 ansible_user=root base_domain=gpu.datakrib.com

# Developer Personal Isolated Devboxes
# Wildcard: *.john.dev.datakrib.com
dev-john ansible_host=198.51.100.30 ansible_user=root base_domain=john.dev.datakrib.com
dev-sarah ansible_host=198.51.100.31 ansible_user=root base_domain=sarah.dev.datakrib.com

# Shared Staging / QA Environment
staging-box ansible_host=198.51.100.40 ansible_user=root base_domain=staging.datakrib.com

[dev_fleet:vars]
ansible_python_interpreter=/usr/bin/python3
admin_email=devops@datakrib.com
