# ==============================================================================
# Multi-Stage Dockerfile for ARA (Autonomous Remediation Agent) Dashboard
# Stage 1: Build React 18 + Vite + Tailwind + Radix UI Frontend
# Stage 2: Serve via Python 3.11 Backend (oversight only — no agent execution)
# ==============================================================================

# ── Stage 1: Frontend Build ──
FROM node:20-alpine AS frontend-builder
WORKDIR /build

COPY dashboard/frontend/package.json ./
RUN npm install

COPY dashboard/frontend ./
RUN npm run build

# ── Stage 2: Production Python Backend (lightweight oversight server) ──
FROM python:3.11-slim
WORKDIR /app

# Minimal system deps — dashboard is read-only oversight, no agent execution
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy backend code
COPY devctl /app/devctl
COPY ai_ops /app/ai_ops
COPY dashboard /app/dashboard

# Copy compiled frontend from Stage 1
COPY --from=frontend-builder /build/dist /app/dashboard/dist
COPY --from=frontend-builder /build/dist /app/dashboard/static

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV DASHBOARD_HOST=0.0.0.0
ENV DASHBOARD_PORT=8888

EXPOSE 8888

CMD ["python3", "/app/dashboard/app.py"]
